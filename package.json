  "description": "基于 Tauri 2 与 React 的 B站账号管理和自动回复桌面应用",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
